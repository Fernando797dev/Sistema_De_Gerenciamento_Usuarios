<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuarios"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Sistema_Gerenciamento_Usuarios.Update"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Update" Height="450" Width="800">
    <Grid Background="#FF27581A">
        <Label Content="Email" HorizontalAlignment="Left" Height="28" Margin="203,197,0,0" VerticalAlignment="Top" Width="122" FontSize="18" FontWeight="Bold"/>
        <Label Content="Nome" HorizontalAlignment="Left" Height="30" Margin="342,0,0,0" VerticalAlignment="Center" Width="103" FontSize="18" FontWeight="Bold"/>
        <Label Content="Senha" HorizontalAlignment="Left" Height="24" Margin="491,201,0,0" VerticalAlignment="Top" Width="102" FontSize="18" FontWeight="Bold"/>
        <Label Content="Status" HorizontalAlignment="Left" Height="25" Margin="490,294,0,0" VerticalAlignment="Top" Width="103" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="digitar_email" HorizontalAlignment="Left" Height="46" Margin="203,230,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="122" Background="Black" Foreground="White"/>
        <TextBlock x:Name="digitar_nome_completo" HorizontalAlignment="Left" Height="46" Margin="342,230,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="123" Background="Black" Foreground="White"/>
        <TextBlock x:Name="digita_senha" HorizontalAlignment="Left" Height="46" Margin="491,230,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="122" Background="Black" Foreground="White"/>
        <Label Content="Perfil" HorizontalAlignment="Left" Height="31" Margin="202,288,0,0" VerticalAlignment="Top" Width="123" FontSize="18" FontWeight="Bold"/>
        <Label Content="Avatar" HorizontalAlignment="Left" Height="31" Margin="342,288,0,0" VerticalAlignment="Top" Width="123" FontSize="18" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Height="46" Margin="342,323,0,0" TextWrapping="Wrap" Text="CARDS" VerticalAlignment="Top" Width="123" Background="Black" Foreground="White"/>
        <ComboBox x:Name="cbStatus" HorizontalAlignment="Left" Margin="491,323,0,0" VerticalAlignment="Top" Width="120" Height="43">
            <ComboBoxItem Content="Ativo"/>
            <ComboBoxItem Content="Inativo"/>
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Label Content="UPDATE" HorizontalAlignment="Center" Height="42" Margin="0,19,0,0" VerticalAlignment="Top" Width="308" FontSize="25" FontWeight="Bold" HorizontalContentAlignment="Center"/>
        <Button x:Name="Botao_Confirmar_update" Content="Update" Height="32" Margin="0,392,0,0" VerticalAlignment="Top" Width="176" HorizontalAlignment="Center" Click="Button_Click"/>
        <TextBlock x:Name="email_alvo" HorizontalAlignment="Left" Height="46" Margin="332,101,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="122" Background="Black" Foreground="White"/>
        <Label Content="Digite o email em que deseja editar" HorizontalAlignment="Left" Height="21" Margin="282,75,0,0" VerticalAlignment="Top" Width="242"/>
        <Button x:Name="botao_procurar" Content="Procurar" Height="35" Margin="332,152,0,0" VerticalAlignment="Top" Width="122" RenderTransformOrigin="0.438,0.515" Click="botao_procurar_Click1"/>
        <ComboBox x:Name="cbPerfil" HorizontalAlignment="Left" Margin="202,323,0,0" VerticalAlignment="Top" Width="120" Height="43">
            <ComboBoxItem Content="Administrador"/>
            <ComboBoxItem Content="Usuario Comum"/>
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
    </Grid>
</Window>
