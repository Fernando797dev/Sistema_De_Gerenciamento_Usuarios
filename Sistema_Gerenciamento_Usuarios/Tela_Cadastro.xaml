<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuarios"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Sistema_Gerenciamento_Usuarios.Tela_Cadastro"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Tela de Cadastro"
        Height="550"
        Width="800">

    <Grid x:Name="cor_fundo" Background="#2D2D30">


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="367*"/>
        </Grid.ColumnDefinitions>

        <!-- Título -->
        <TextBlock x:Name="txtTitulo"
                   Height="77"
                   Margin="167,20,245,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   FontSize="36"
                   FontWeight="Bold"
                   FontFamily="Tw Cen MT"
                   TextAlignment="Center"
                   Grid.Column="1"
                   FontStyle="Italic"
                   Foreground="White"
                   Text="CADASTRO DE USUÁRIOS"/>
        <Button x:Name="Avatar1" Width="60" Height="60" Margin="5,-20,5,425
" Padding="0" 
            Click="Avatar1_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Image Source="/Image/avatar1Certo.webp" Stretch="Uniform"/>
        </Button>
        <!--AVATAR 2-->
        <Button x:Name="Avatar2" Width="60" Height="60" Margin="5,-20,5,250" Padding="0" 
            Click="Avatar2_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Image Source="/Image/avatar2Certo.webp" Stretch="Uniform"/>
        </Button>
        <!--AVATAR 3-->
        <Button x:Name="Avatar3" Width="60" Height="60" Margin="5,-20,5,50" Padding="0" 
            Click="Avatar3_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Image Source="/Image/avatar3Certo.webp" Stretch="Uniform"/>
        </Button>
        <!--AVATAR 4-->
        <Button x:Name="Avatar4" Width="60" Height="60" Margin="5,-20,5,-150" Padding="0" 
            Click="Avatar4_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Image Source="/Image/avatar4Certo.webp" Stretch="Uniform"/>
        </Button>
        <!--AVATAR 5-->
        <Button x:Name="Avatar5" Width="60" Height="60" Margin="5,-20,5,-350" Padding="0" 
            Click="Avatar5_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Image Source="/Image/avatar5Certo.webp" Stretch="Uniform"/>
        </Button>

        <!-- Tipo de cadastro -->
        <TextBlock x:Name="txtTipoCadastro"
                   Height="36"
                   Margin="167,104,245,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   FontSize="18"
                   FontWeight="Bold"
                   FontFamily="Tw Cen MT"
                   TextAlignment="Center"
                   Grid.Column="1"
                   FontStyle="Italic"
                   Foreground="#FF67FF01"
                   Text="USUÁRIO"/>

        <!-- E-mail -->
        <TextBlock x:Name="email"
                   HorizontalAlignment="Left"
                   Height="20"
                   Margin="267,193,0,0"
                   VerticalAlignment="Top"
                   Width="128"
                   FontFamily="Times New Roman"
                   Grid.Column="1"
                   Foreground="White"
                   Text="E-MAIL"/>

        <TextBox x:Name="digita_email"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="267,213,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="157"
                 Grid.Column="1"/>

        <!-- Usuário -->
        <TextBlock HorizontalAlignment="Left"
                   Height="20"
                   Margin="267,256,0,0"
                   VerticalAlignment="Top"
                   Width="148"
                   FontFamily="Times New Roman"
                   Grid.Column="1"
                   Foreground="White"
                   Text="USUÁRIO"/>

        <TextBox x:Name="digita_usuario"
                 HorizontalAlignment="Left"
                 Height="45"
                 Margin="267,273,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="157"
                 Grid.Column="1"/>

        <!-- Senha -->
        <TextBlock HorizontalAlignment="Left"
                   Height="20"
                   Margin="267,322,0,0"
                   VerticalAlignment="Top"
                   Width="148"
                   FontFamily="Times New Roman"
                   Grid.Column="1"
                   Foreground="White"
                   Text="SENHA"/>

        <PasswordBox x:Name="digita_senha"
                     HorizontalAlignment="Left"
                     Height="29"
                     Margin="267,339,0,0"
                     VerticalAlignment="Top"
                     Width="140"
                     Grid.Column="1"/>

        <!-- Confirmar senha -->
        <TextBlock HorizontalAlignment="Left"
                   Height="20"
                   Margin="267,373,0,0"
                   VerticalAlignment="Top"
                   Width="148"
                   FontFamily="Times New Roman"
                   Grid.Column="1"
                   Foreground="White"
                   Text="CONFIRMAR SENHA"/>

        <PasswordBox x:Name="digita_confirmar_senha"
                     HorizontalAlignment="Left"
                     Height="34"
                     Margin="267,395,0,0"
                     VerticalAlignment="Top"
                     Width="140"
                     Grid.Column="1"/>

        <!-- Senha do administrador -->
        <TextBlock x:Name="lblSenhaAdmin"
                   HorizontalAlignment="Left"
                   Height="35"
                   Margin="400,360,0,0"
                   VerticalAlignment="Top"
                   Width="400"
                   FontFamily="Times New Roman"
                   Grid.Column="1"
                   Foreground="#FFFFCC00"
                   Text="SENHA DO ADMINISTRADOR"
                   Visibility="Collapsed"/>

        <PasswordBox x:Name="digita_senha_admin"
                     HorizontalAlignment="Left"
                     Height="35"
                     Margin="400,360,0,0"
                     VerticalAlignment="Top"
                     Width="140"
                     Grid.Column="1"
                     Visibility="Collapsed"/>

        <!-- Botão Cadastro -->
        <Button x:Name="btn_login_cadastro"
                Content="CADASTRAR USUÁRIO"
                Margin="199,465,0,0"
                VerticalAlignment="Top"
                Width="196"
                Height="30"
                FontFamily="Times New Roman"
                Grid.Column="1"
                Background="#FF67FF01"
                FontWeight="Bold"
                Click="btn_login_cadastro_Click"/>

        <!-- Botão criar administrador -->
        <Button x:Name="btnCriarAdmin"
                Content="CRIAR ADMIN"
                Margin="439,465,0,0"
                VerticalAlignment="Top"
                Width="120"
                Height="30"
                FontFamily="Times New Roman"
                Grid.Column="1"
                Background="#FFFFCC00"
                FontWeight="Bold"
                Click="btnCriarAdmin_Click"/>

        <!-- AVATARES -->

        <!-- Identificação -->
        <TextBlock x:Name="txtAdmin"
                   Height="40"
                   Margin="-332,484,398,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   FontSize="22"
                   FontWeight="Bold"
                   FontFamily="Tw Cen MT"
                   TextAlignment="Center"
                   FontStyle="Italic"
                   Foreground="White"
                   Text="ADMIN"
                   Grid.ColumnSpan="2"/>
        <TextBox x:Name="digita_nome_completo" Grid.Column="1" HorizontalAlignment="Left" Height="35" Margin="262,153,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="158"/>
        <TextBlock x:Name="nome_completo"
            HorizontalAlignment="Left"
            Height="20"
            Margin="267,133,0,0"
            VerticalAlignment="Top"
            Width="128"
            FontFamily="Times New Roman"
            Grid.Column="1"
            Foreground="White"
            Text="NOME"/>

        <!--OS AVATARES -->
    </Grid>

</Window>