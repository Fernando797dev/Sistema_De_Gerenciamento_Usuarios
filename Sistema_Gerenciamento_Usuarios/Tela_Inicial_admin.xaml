<Window x:Class="Sistema_Gerenciamento_Usuarios.Tela_Inicial_admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuarios"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Tela_Inicial_admin" Height="450" Width="800">


    <Grid Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- CARD DO ADMIN -->
        <Border
    Width="332"
    Height="249"
    Background="White"
    CornerRadius="15"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Margin="162,58,0,0">
            <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center" Height="185" Width="188">
                <!-- AVATAR -->
                <Border
            Width="100
"
            Height="80"
            CornerRadius="40"
            Margin="0,5,0,10">
                    <Image
                Source="Images/admin-avatar.png"
                Stretch="UniformToFill"/>
                </Border>
                <TextBlock
            Text="ADM"
            FontFamily="Arial Black"
            FontSize="17"
            Foreground="#333333"/>
                <TextBlock
            Text="admin@email.com"
            FontSize="14"
            Foreground="#666666"/>
                <TextBlock
            Text="@admin"
            FontSize="14"
            Foreground="#666666"/>
                <!-- NOME -->
                <!-- EMAIL -->
                <!-- USERNAME -->
            </StackPanel>
        </Border>
        <Button x:Name="Botao_Criar_usuario" Content="Criar um novo usuário" Height="39" Margin="607,56,0,0" VerticalAlignment="Top" Width="152" FontSize="13" Click="Button_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Botao_Listar_usuario" Content="Listar usuários" Height="39" Margin="607,112,0,0" VerticalAlignment="Top" Width="152" FontSize="13" Click="Botao_Listar_usuario_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Botao_Editar_usuario" Content="Editar usuários" Height="39" Margin="607,163,0,0" Width="152" FontSize="13" VerticalAlignment="Top" Click="Botao_Editar_usuario_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Botao_Apagar_usuarios" Content="Apagar usuários" Height="39" Margin="607,222,0,0" VerticalAlignment="Top" Width="152" FontSize="13" Click="Botao_Apagar_usuarios_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
